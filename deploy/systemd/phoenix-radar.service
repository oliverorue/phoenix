[Unit]
Description=Phoenix radar (Streamlit + scanner + paper/live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/phoenix
ExecStart=/opt/phoenix/venv/bin/streamlit run bot/dashboard/app.py --server.address=127.0.0.1 --server.port=8502 --server.headless=true --server.fileWatcherType=none --browser.gatherUsageStats=false
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
