# config/secrets.env.example
# ⚠️ Copiá este archivo como secrets.env y reemplazá los placeholders.
# NUNCA subas secrets.env con valores reales al repositorio.
#
#   cp config/secrets.env.example config/secrets.env
#
# El monitor es SOLO lectura: NO necesita API keys de Binance.
# Únicamente se usan estos tokens si querés alertas por Telegram/Discord.

# Notificaciones opcionales (Telegram / Discord)
TELEGRAM_TOKEN=TU_TELEGRAM_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI
DISCORD_WEBHOOK=TU_DISCORD_WEBHOOK_AQUI
