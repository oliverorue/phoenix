# config/secrets.env.example
# ⚠️ Copiá este archivo como secrets.env y reemplazá los placeholders con tus API keys.
# NUNCA subas secrets.env con claves reales al repositorio.
#
#   cp config/secrets.env.example config/secrets.env

# Claves de Binance USDⓈ-M Futures (Testnet o Mainnet)
BINANCE_API_KEY=TU_API_KEY_AQUI
BINANCE_API_SECRET=TU_API_SECRET_AQUI

# Entorno (true = Testnet, false = Mainnet)
# Fuente principal: exchange.testnet en config/settings.yaml.
# Si definís TESTNET acá, DEBE coincidir con settings.yaml; si no, el bot
# se niega a arrancar para evitar operar en el entorno equivocado.
# ⚠️ PRIMERO prueba en Testnet durante 1-2 semanas
# TESTNET=true

# Confirmación explícita para operar en mainnet real.
# Solo se exige cuando paper_trading.enabled=false y exchange.testnet=false.
LIVE_TRADING_CONFIRMED=false

# Símbolo por defecto (solo XRPUSDT es viable con $50)
SYMBOL=XRPUSDT

# Notificaciones opcionales (Telegram / Discord)
TELEGRAM_TOKEN=TU_TELEGRAM_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI
DISCORD_WEBHOOK=TU_DISCORD_WEBHOOK_AQUI
